{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://heritage-short.local/schema/storyboard.schema.json",
  "title": "StoryboardSchema",
  "description": "Strict JSON schema contract defining project metadata and shot sequence for heritage-short AI short film pipeline.",
  "type": "object",
  "required": [
    "project",
    "shots"
  ],
  "additionalProperties": false,
  "properties": {
    "project": {
      "type": "object",
      "required": [
        "title",
        "language",
        "aspect_ratios",
        "fps",
        "style_block",
        "character_bible",
        "music",
        "end_card_text"
      ],
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string",
          "minLength": 3
        },
        "language": {
          "type": "string",
          "pattern": "^[a-z]{2}(-[A-Z]{2})?$"
        },
        "aspect_ratios": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["16:9", "9:16"]
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "fps": {
          "type": "integer",
          "default": 24,
          "minimum": 12,
          "maximum": 60
        },
        "style_block": {
          "type": "string",
          "minLength": 20,
          "description": "Immutable art style, lighting, lens, and color palette prepended to every keyframe prompt."
        },
        "character_bible": {
          "type": "string",
          "minLength": 20,
          "description": "Immutable description of the main character's age, clothing, face, and posture."
        },
        "music": {
          "type": "object",
          "required": [
            "caption",
            "bpm",
            "key",
            "duration_s",
            "seed",
            "instrumental",
            "selected_file"
          ],
          "additionalProperties": false,
          "properties": {
            "caption": {
              "type": "string",
              "minLength": 10
            },
            "bpm": {
              "type": "integer",
              "minimum": 30,
              "maximum": 240
            },
            "key": {
              "type": "string",
              "minLength": 1
            },
            "duration_s": {
              "type": "number",
              "minimum": 10.0
            },
            "seed": {
              "type": "integer"
            },
            "instrumental": {
              "type": "boolean"
            },
            "selected_file": {
              "type": "string"
            }
          }
        },
        "end_card_text": {
          "type": "string",
          "minLength": 15,
          "description": "End card text explicitly declaring AI-assisted generation and provenance."
        }
      }
    },
    "shots": {
      "type": "array",
      "minItems": 8,
      "maxItems": 12,
      "items": {
        "type": "object",
        "required": [
          "id",
          "reason",
          "shot_type",
          "narration_text",
          "subtitle_en",
          "tts_style",
          "tts_voice",
          "image_prompt",
          "motion_prompt",
          "seed",
          "video_mode",
          "ken_burns_motion",
          "pad_after_s"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^shot_[0-9]{2}$"
          },
          "reason": {
            "type": "string",
            "minLength": 10
          },
          "shot_type": {
            "type": "string",
            "enum": [
              "establishing",
              "wide",
              "medium",
              "medium_close_up",
              "close_up",
              "insert"
            ]
          },
          "narration_text": {
            "type": "string",
            "minLength": 1
          },
          "subtitle_en": {
            "type": "string",
            "maxLength": 80
          },
          "tts_style": {
            "type": "string",
            "minLength": 3
          },
          "tts_voice": {
            "type": "string",
            "minLength": 2
          },
          "image_prompt": {
            "type": "string",
            "minLength": 20
          },
          "motion_prompt": {
            "type": "string",
            "minLength": 10
          },
          "seed": {
            "type": "integer"
          },
          "video_mode": {
            "type": "string",
            "enum": [
              "wan22",
              "ken_burns"
            ]
          },
          "ken_burns_motion": {
            "type": "string",
            "enum": [
              "zoom_in",
              "zoom_out",
              "pan_left",
              "pan_right"
            ]
          },
          "pad_after_s": {
            "type": "number",
            "default": 0.4,
            "minimum": 0.0,
            "maximum": 5.0
          }
        }
      }
    }
  }
}
